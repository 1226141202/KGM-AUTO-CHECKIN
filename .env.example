# kgcheckin 私密配置模板
# 复制本文件为 .env（已被 .gitignore 忽略，不会提交），填入自己的值即可生效。
# 通知渠道全部可选，配置多个将同时发送。

# ── WebUI 访问密码（公网暴露时强烈建议设置）──
# WEBUI_PASSWORD=change-me

# ── 账号管理模块独立密码（与访问密码相互独立）──
# 设置后查看/删除账号需额外输入此密码；连续 3 次错误将锁定 5 分钟（防爆破）
# ACCOUNTS_PASSWORD=change-me-too
# 可选覆盖默认防爆破策略：
# ACCOUNTS_MAX_ATTEMPTS=3
# ACCOUNTS_LOCK_MINUTES=5

# ── 邮箱 SMTP 通知 ──
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_USER=your_email@qq.com
# MAIL_PASS=SMTP授权码（非登录密码）
# MAIL_TO=your_email@qq.com

# ── 企业微信机器人 ──
# WECOM_BOT_KEY=

# ── 钉钉机器人（加签可选）──
# DINGTALK_BOT_KEY=
# DINGTALK_SECRET=

# ── 飞书机器人 ──
# FEISHU_BOT_KEY=

# ── 云湖机器人 ──
# YUNHU_BOT_KEY=

# ── Server酱 ──
# SERVERCHAN_SENDKEY=

# ── PushPlus ──
# PUSHPLUS_TOKEN=
# PUSHPLUS_TOPIC=

# ── Telegram ──
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# ── Bark (iOS) ──
# BARK_KEY=
# BARK_GROUP=

# ── Discord Webhook ──
# DISCORD_WEBHOOK=
