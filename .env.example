# kgcheckin 私密配置模板
# 复制本文件为 .env（已被 .gitignore 忽略，不会提交），填入自己的值即可生效。
# 通知渠道全部可选，配置多个将同时发送。

# ── WebUI 访问密码（公网暴露时强烈建议设置）──
# WEBUI_PASSWORD=change-me

# ── 账号管理模块密码 ──
# 账号管理采用「每账号独立密码」：账号需由 admin 为其设置密码后才能自助登录
# （不再支持"默认密码=酷狗ID"，该行为存在被撞库风险）。
# 此处设置的是管理员账号 admin 的密码；不设置则 admin 不可用。
# 首次部署也可用 ACCOUNTS_BOOTSTRAP_PASSWORD 初始化 admin 密码（写入 accounts_auth.json）。
# ACCOUNTS_PASSWORD=change-me-too
# ACCOUNTS_BOOTSTRAP_PASSWORD=
# 防爆破：单账号 / 单 IP 双维度锁定
# ACCOUNTS_MAX_ATTEMPTS=3
# ACCOUNTS_IP_MAX_ATTEMPTS=15
# ACCOUNTS_LOCK_MINUTES=5
# 兼容开关（默认关闭）：开启后未设密码的账号仍可用「酷狗ID 作为密码」登录。
# 仅用于从旧版本平滑迁移，迁移完成后请关闭并尽快为各账号设置密码。
# ACCOUNTS_ALLOW_ID_DEFAULT=false

# ── 反向代理 ──
# 部署在 Nginx/Caddy 等反向代理之后时设置，以获取真实客户端 IP。
# 未设置时不信任 X-Forwarded-For，避免伪造 IP 绕过防爆破计数。
# WEBUI_TRUST_PROXY=1

# ── 酷狗设备标识（建议设置并固定）──
# 登录 API 服务每次重启默认随机生成设备 ID，频繁变化会被酷狗风控静默丢弃验证码短信；
# 固定后风控看到的是稳定设备。MID 建议 36-39 位纯数字，DEV 建议 10 位大写字母数字。
# KUGOU_API_GUID=
# KUGOU_API_MID=
# KUGOU_API_DEV=

# ── 邮箱 SMTP 通知 ──
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_USER=your_email@qq.com
# MAIL_PASS=SMTP授权码（非登录密码）
# MAIL_TO=your_email@qq.com

# ── 企业微信机器人 ──
# WECOM_BOT_KEY=

# ── 钉钉机器人（加签可选）──
# DINGTALK_BOT_KEY=
# DINGTALK_SECRET=

# ── 飞书机器人 ──
# FEISHU_BOT_KEY=

# ── 云湖机器人 ──
# YUNHU_BOT_KEY=

# ── Server酱 ──
# SERVERCHAN_SENDKEY=

# ── PushPlus ──
# PUSHPLUS_TOKEN=
# PUSHPLUS_TOPIC=

# ── Telegram ──
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# ── Bark (iOS) ──
# BARK_KEY=
# BARK_GROUP=

# ── Discord Webhook ──
# DISCORD_WEBHOOK=
